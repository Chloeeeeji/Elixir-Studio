<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/PaddleBall/UI/Uss/PaddleBallScreens.uss?fileID=7433441132597879392&amp;guid=5f1fa7b4fc1384e90a776788b57e71c1&amp;type=3#PaddleBallScreens"/>
    <ui:VisualElement name="splash__background" class="splash-screen">
        <ui:VisualElement name="splash__background-image" class="menu-screen__background menu-screen__background--menu"/>
        <ui:VisualElement name="splash__load-panel" class="splash-panel">
            <ui:Label text="LOADING" display-tooltip-when-elided="true" name="splash__loading-text" class="splash-loading-text"/>
            <ui:ProgressBar value="0" name="splash__progress-bar" class="splash-progress-bar"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
