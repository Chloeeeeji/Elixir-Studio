.menu-button {
    width: 80%;
    height: 15%;
    background-color: rgba(255, 255, 255, 0);
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
    font-size: 90px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-left: 5px;
    margin-bottom: 5px;
    text-shadow: 2px 2px 1px rgba(0, 0, 0, 0.4);
    -unity-font-style: bold;
}

.menu-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.15s;
    background-color: rgba(209, 209, 209, 0.24);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

.menu-button:active {
    color: rgb(255, 156, 0);
}

.menu-button:focus {
    -unity-background-image-tint-color: rgb(245, 160, 27);
    background-color: rgba(209, 209, 209, 0);
}

.pause-button {
    width: 75%;
    height: 15%;
    background-color: rgba(255, 255, 255, 0);
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Bold/Inter-Bold%20SDF_FontAsset.asset?fileID=11400000&guid=95b70fa7ea03d427e8c7511cab180b86&type=2#Inter-Bold SDF_FontAsset");
    font-size: 90px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.22);
}

.pause-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.15s;
    background-color: rgba(209, 209, 209, 0.99);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.pause-button:active {
    color: rgb(255, 156, 0);
    -unity-background-image-tint-color: rgb(255, 156, 0);
}

.pause-button:focus {
    background-color: rgba(209, 209, 209, 0);
}

.back-button {
    position: absolute;
    right: 0;
    bottom: 1%;
    width: 20%;
    height: 12%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
    font-size: 50px;
    color: rgb(255, 255, 255);
    background-color: rgba(188, 188, 188, 0);
    transition-duration: 0.15s;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.31);
    -unity-font-style: bold;
}

.back-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.15s;
}

.back-button:active {
    transition-duration: 0.15s;
    -unity-background-image-tint-color: rgb(253, 163, 11);
    color: rgb(255, 130, 1);
}

.back-button:focus {
    -unity-background-image-tint-color: rgb(245, 160, 27);
}

#unity-dragger {
    background-image: url("project://database/Assets/PaddleBall/Textures/Icons/Circle512.png?fileID=21300000&guid=e0cf8806d35d64013ba4e5d0e6b11fba&type=3#Circle512");
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    top: 38%;
}

#unity-tracker {
    top: 44%;
    margin-left: 2%;
    scale: 0.95 1;
}

.credit-line {
    width: 100%;
    flex-basis: 12%;
    color: rgb(255, 255, 255);
}

.body-text {
    flex-basis: 90%;
    flex-grow: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 20px;
    margin-bottom: 20px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 40px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Medium/Inter-Medium%20SDF_FontAsset.asset?fileID=11400000&guid=3a7d7cc90e43f44478bfccf76c97073e&type=2#Inter-Medium SDF_FontAsset");
    font-size: 38px;
    -unity-text-align: upper-center;
    flex-wrap: wrap;
    white-space: normal;
    color: rgb(255, 255, 255);
    transition-duration: 1s;
    width: 100%;
    height: 100%;
}

.button-nextlast {
    flex-basis: 10%;
    font-size: 101px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Medium/Inter-Medium%20SDF_FontAsset.asset?fileID=11400000&guid=3a7d7cc90e43f44478bfccf76c97073e&type=2#Inter-Medium SDF_FontAsset");
    background-color: rgba(188, 188, 188, 0);
    background-image: url("project://database/Assets/PaddleBall/Textures/Icons/Next_Icon.png?fileID=21300000&guid=140f2f7729c4f4e2185c86b4a582f120&type=3#Next_Icon");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 180deg;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button-nextlast:hover {
    transition-duration: 0.1s;
    scale: 1.1 1.1;
}

.button-nextlast:active {
    -unity-background-image-tint-color: rgb(255, 156, 0);
}

.tutorial-button {
    position: absolute;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    background-color: rgba(188, 188, 188, 0);
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Roboto/Roboto-Black%20SDF_FontAsset.asset?fileID=11400000&guid=e74ebc05ab3564fb187648ced4e2c0fa&type=2#Roboto-Black SDF_FontAsset");
    font-size: 35px;
    color: rgb(255, 255, 255);
    flex-basis: 34%;
    height: 65%;
    margin-right: 0;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-grow: 0;
}

.tutorial-button:hover {
    transition-duration: 0.1s;
    scale: 1.1 1.1;
}

.tutorial-button:active {
    transition-duration: 0.1s;
    -unity-background-image-tint-color: rgb(255, 156, 0);
    background-color: rgba(255, 156, 0, 0.24);
    color: rgb(255, 156, 0);
    border-left-color: rgb(255, 156, 0);
    border-right-color: rgb(255, 156, 0);
    border-top-color: rgb(255, 156, 0);
    border-bottom-color: rgb(255, 156, 0);
}

.title-text {
    height: 19%;
    width: 53%;
    position: absolute;
    font-size: 110px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
    color: rgb(255, 255, 255);
    -unity-text-align: upper-right;
