    margin-right: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.62);
    -unity-font-style: bold;
}

.subheading-text {
    position: absolute;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
    font-size: 50px;
    bottom: -10%;
    right: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.background-image {
    position: absolute;
    width: 250%;
    height: 240%;
    -unity-background-scale-mode: scale-to-fit;
}

/* ================================================================ screen layout
 *
 * The rules below place the elements of each screen. They were inline style attributes on the
 * UXML until they moved here, so the modifiers are ordered to follow the base class they refine
 * -- .menu-button--list after .menu-button, and so on.
 */

/* ---------------------------------------------------------------- menu-style screens */

/* Main menu, Design Patterns and Play Mode share a full-screen frame */
.menu-screen {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: flex-end;
    background-color: rgb(82, 82, 82);
}

.menu-screen--left {
    align-items: flex-start;
}

/* Each screen's backdrop is the same oversized, scaled-to-fit image placed differently */
.menu-screen__background {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

/* Also used by the splash screen, so the two share one backdrop rather than drifting apart */
.menu-screen__background--menu {
    width: 141%;
    height: 169%;
    top: -432px;
    right: -604px;
    left: -183px;
    scale: 1.3 1.3;
    translate: -2% 7%;
    background-image: url("project://database/Assets/PaddleBall/Textures/Backgrounds/BackgroundConcrete.png?fileID=21300000&guid=fede72989d0965842a8e015db57f83d7&type=3#BackgroundConcrete");
}

.menu-screen__background--patterns {
    width: 117%;
    height: 297%;
    top: -80%;
    left: -1%;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/PaddleBall/Textures/Backgrounds/BackgroundTrailSparks.png?fileID=2800000&guid=66bc9b35e7487464dabb07ac355f1530&type=3#BackgroundTrailSparks");
}

.menu-screen__background--play {
    width: 192%;
    height: 319%;
    top: -112%;
    left: -53%;
    background-color: rgb(0, 0, 0);
    background-image: url("project://database/Assets/PaddleBall/Textures/Backgrounds/BackgroundBlueLight.png?fileID=2800000&guid=adfbf0eda11d95b4eb23841f00360c31&type=3#BackgroundBlueLight");
}

/* The stack of buttons down one side */
.menu-column {
    position: absolute;
    flex-basis: 60%;
    height: 56%;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.menu-column--menu {
    width: 35%;
    align-items: flex-end;
    top: 48%;
    bottom: 0;
    right: 4%;
}

.menu-column--patterns {
    width: 40%;
    align-items: flex-start;
    top: 34%;
    left: 8%;
}

.menu-column--play {
    width: 35%;
    align-items: flex-start;
    top: 46%;
    left: 13%;
}

/* ---------------------------------------------------------------- menu button sizes */

.menu-button--large {
    font-size: 100px;
    height: 23%;
}

.menu-button--medium {
    font-size: 75px;
}

/* A left-aligned row in a list of pattern names */
.menu-button--list {
    width: 100%;
    font-size: 55px;
    -unity-text-align: middle-left;
}

.menu-button--list-tall {
    height: 91px;
}

.menu-button--list-wrap {
    white-space: normal;
}

/* A game mode on the Play Mode screen */
.menu-button--mode {
    width: 80%;
    -unity-text-align: middle-left;
}

.menu-button--mode-indent {
    font-size: 60px;
    left: 7%;
}

/* Hidden until the mode ships. Follows --mode so its width wins. */
.menu-button--mode-hidden {
    display: none;
    width: 90%;
    font-size: 60px;
    left: 7%;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Bold/Inter-Bold%20SDF_FontAsset.asset?fileID=11400000&guid=95b70fa7ea03d427e8c7511cab180b86&type=2#Inter-Bold SDF_FontAsset");
}

.coming-soon-label {
    position: absolute;
    left: 56%;
    top: 34%;
    font-size: 23px;
    color: rgb(255, 156, 0);
}

/* ---------------------------------------------------------------- per-screen title shadows */

.title-text--menu {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.32);
}

.subheading-text--menu {
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.55);
}

.title-text--patterns {
    width: 67%;
    left: 5%;
}

.title-text--play {
    width: 36%;
    left: 12%;
    top: 15%;
}

/* ---------------------------------------------------------------- splash screen */

.splash-screen {
    flex-basis: 100%;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    background-color: rgb(38, 38, 38);
}

.splash-panel {
    display: flex;
    flex-grow: 1;
    width: 59%;
    height: 66%;
    max-height: 50%;
    top: -9%;
    right: -23%;
    align-items: center;
    justify-content: center;
}

.splash-loading-text {
    flex-basis: 16%;
    font-size: 39px;
    color: rgb(255, 255, 255);
    -unity-text-align: lower-left;
    letter-spacing: 13px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
}

.splash-progress-bar {
    width: 50%;
    height: 10px;
    color: rgb(185, 185, 185);
    background-color: rgb(255, 255, 255);
}

/* ---------------------------------------------------------------- bootloader screen */

/* Shown in the Editor when the game is entered from a scene other than the bootstrap one.
   Close to the splash screen but anchored and aligned differently, so it is kept separate. */
.bootloader-screen {
    position: absolute;
    flex-basis: 100%;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: flex-end;
    justify-content: center;
    font-size: 11px;
    background-color: rgb(38, 38, 38);
}

.bootloader-screen__background {
    position: absolute;
    left: -79%;
    scale: -0.75 0.75;
    translate: 70px 112px;
    background-position-x: left 0;
    background-position-y: top 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/PaddleBall/Textures/Backgrounds/BackgroundTrailSparks.png?fileID=2800000&guid=66bc9b35e7487464dabb07ac355f1530&type=3#BackgroundTrailSparks");
}

.bootloader-panel {
    display: flex;
    flex-grow: 1;
    width: 53%;
    height: 66%;
    max-height: 50%;
    align-items: center;
    justify-content: center;
    color: rgb(255, 255, 255);
    background-size: 112% 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.bootloader-instructions {
    position: relative;
    font-size: 37px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
}

/* ---------------------------------------------------------------- game screen */

.game-screen {
    width: 100%;
    height: 100%;
    align-items: flex-end;
}

/* Pairs with .pause-button, which this follows so the placement below wins */
.game-screen__pause-button {
    flex-basis: 10%;
    width: 4%;
    height: 10%;
    right: 2%;
    top: 2%;
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(88, 88, 88, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(225, 255, 227, 0.51);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/PaddleBall/Textures/Icons/PauseButton.png?fileID=21300000&guid=1f5c386e3724e463c8b289923e24c884&type=3#PauseButton");
}

/* ---------------------------------------------------------------- demo screen shell */

/* The frame the pattern demos draw their own UI into. Mirrors .tutorial-screen in
   TutorialScreens.uss, which this screen does not reference. */
.demo-screen {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------------------------------------------------------------- credits line template */

.credit-line__group {
    position: absolute;
    width: 100%;
    flex-direction: row;
    flex-shrink: 9;
    align-items: flex-end;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.credit-line__role {
    width: 50%;
    font-size: 25px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
    -unity-font-style: normal;
    margin-left: 0;
    margin-right: 5%;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Bold/Inter-Bold%20SDF_FontAsset.asset?fileID=11400000&guid=95b70fa7ea03d427e8c7511cab180b86&type=2#Inter-Bold SDF_FontAsset");
}

.credit-line__name {
    position: absolute;
    display: flex;
    width: 50%;
    left: 55%;
    font-size: 25px;
    -unity-text-align: middle-left;
    justify-content: flex-start;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Medium/Inter-Medium%20SDF_FontAsset.asset?fileID=11400000&guid=3a7d7cc90e43f44478bfccf76c97073e&type=2#Inter-Medium SDF_FontAsset");
}
