.menu-button {
    width: 70%;
    height: 15%;
    background-color: rgba(255, 255, 255, 0);
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Roboto/Roboto-Black%20SDF_FontAsset.asset?fileID=11400000&guid=e74ebc05ab3564fb187648ced4e2c0fa&type=2#Roboto-Black SDF_FontAsset");
    font-size: 90px;
    color: rgb(255, 255, 255);
    -unity-text-align: lower-center;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-left: 5px;
    margin-bottom: 5px;
}

.menu-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.15s;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-text-align: lower-center;
}

.menu-button:active {
    color: rgb(255, 156, 0);
    -unity-text-align: lower-center;
    transition-duration: 0.15s;
}

.menu-button:focus {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(209, 209, 209, 0);
    -unity-text-align: lower-center;
    transition-duration: 0.15s;
}

.back-button {
    position: absolute;
    right: -3%;
    bottom: 1%;
    width: 20%;
    height: 12%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Roboto/Roboto-Black%20SDF_FontAsset.asset?fileID=11400000&guid=e74ebc05ab3564fb187648ced4e2c0fa&type=2#Roboto-Black SDF_FontAsset");
    font-size: 78px;
    color: rgb(255, 255, 255);
    background-color: rgba(188, 188, 188, 0);
    transition-duration: 0.15s;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.back-button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.15s;
}

.back-button:active {
    transition-duration: 0.15s;
    -unity-background-image-tint-color: rgb(253, 163, 11);
    color: rgb(255, 130, 1);
}

.back-button:focus {
    -unity-background-image-tint-color: rgb(245, 160, 27);
}

#unity-dragger {
    background-image: url("project://database/Assets/PaddleBall/Textures/Icons/Circle512.png?fileID=21300000&guid=e0cf8806d35d64013ba4e5d0e6b11fba&type=3#Circle512");
    width: 50px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    top: 38%;
}

#unity-tracker {
    top: 44%;
    margin-left: 2%;
    scale: 0.95 1;
}

.credit-line {
    width: 100%;
    flex-basis: 12%;
}

.body-text {
    flex-basis: 90%;
    flex-grow: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 20px;
    margin-bottom: 20px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 40px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Medium/Inter-Medium%20SDF_FontAsset.asset?fileID=11400000&guid=3a7d7cc90e43f44478bfccf76c97073e&type=2#Inter-Medium SDF_FontAsset");
    font-size: 38px;
    -unity-text-align: upper-center;
    flex-wrap: wrap;
    white-space: normal;
    color: rgb(255, 255, 255);
    transition-duration: 1s;
}

.button-nextlast {
    flex-basis: 10%;
    font-size: 101px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Inter/Inter-Medium/Inter-Medium%20SDF_FontAsset.asset?fileID=11400000&guid=3a7d7cc90e43f44478bfccf76c97073e&type=2#Inter-Medium SDF_FontAsset");
    background-color: rgba(188, 188, 188, 0);
    background-image: url("project://database/Assets/PaddleBall/Textures/Icons/Next_Icon.png?fileID=21300000&guid=140f2f7729c4f4e2185c86b4a582f120&type=3#Next_Icon");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 180deg;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.button-nextlast:hover {
    transition-duration: 0.1s;
    scale: 1.1 1.1;
}

.button-nextlast:active {
    -unity-background-image-tint-color: rgb(255, 156, 0);
}

.tutorial-button {
    position: absolute;
    left: 25%;
    width: 50%;
    height: 61%;
    border-top-left-radius: 25px;
    border-bottom-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    background-color: rgba(188, 188, 188, 0);
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
    font-size: 35px;
    color: rgb(255, 255, 255);
    top: 19%;
}

.tutorial-button:hover {
    transition-duration: 0.1s;
    scale: 1.1 1.1;
}

.tutorial-button:active {
    transition-duration: 0.1s;
    -unity-background-image-tint-color: rgb(255, 156, 0);
    background-color: rgba(255, 156, 0, 0.24);
    color: rgb(255, 156, 0);
    border-left-color: rgb(255, 156, 0);
    border-right-color: rgb(255, 156, 0);
    border-top-color: rgb(255, 156, 0);
    border-bottom-color: rgb(255, 156, 0);
}

/* ================================================================ pause popup
 *
 * PausePopup.uxml is the one screen that references this stylesheet, and takes its button
 * appearance from the .tutorial-button rule above. These rules were inline style attributes on
 * that UXML until they moved here, so .pause-popup__button follows the base it refines.
 */

.pause-popup {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.pause-popup__background {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background-color: rgba(34, 34, 34, 0.62);
    -unity-text-outline-color: rgba(0, 0, 0, 0.79);
}

.pause-popup__box {
    flex-basis: 50%;
    width: 50%;
    background-color: rgba(199, 250, 226, 0.47);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-left-color: rgb(195, 195, 195);
    border-right-color: rgb(195, 195, 195);
    border-top-color: rgb(195, 195, 195);
    border-bottom-color: rgb(195, 195, 195);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.pause-popup__header {
    flex-basis: 10%;
}

.pause-popup__body {
    flex-basis: 70%;
}

.pause-popup__footer {
    flex-basis: 15%;
}

.pause-popup__text {
    flex-basis: 70%;
    font-size: 62px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
}

.pause-popup__buttons {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 103%;
    -unity-text-align: upper-center;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

/* Pairs with .tutorial-button. That rule places itself absolutely at left 25%; these two sit in
   a row instead, so they opt out of the horizontal placement but keep its vertical offset. */
.pause-popup__button {
    position: relative;
    left: 0;
    flex-basis: 30%;
    font-size: 36px;
    transition-duration: 0.1s;
    -unity-font-style: bold;
    background-color: rgba(188, 188, 188, 0);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-definition: url("project://database/Assets/_ThirdParty/Fonts/Orbitron/Orbitron-VariableFont_wght%20SDF.asset?fileID=11400000&guid=a7af69d380b2b4d7fbb3702d95e22981&type=2#Orbitron-VariableFont_wght SDF");
}

.pause-popup__button--quit {
    width: 31%;
    margin-right: 10px;
}

.pause-popup__button--resume {
    width: 33%;
    margin-left: 10px;
}
